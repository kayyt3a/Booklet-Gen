# Provider selection: "gemini" or "claude"
LLM_PROVIDER=gemini

# Model names (override per-provider defaults if needed).
# FAST is only used for outline parsing. STRONG is used for everything
# quality-sensitive: question generation, the LLM judge, the mini-lesson
# writer, and exam papers. That is the one worth spending on.
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_STRONG=gemini-2.5-flash
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_STRONG=claude-opus-4-8

# API keys. GEMINI_API_KEY is needed for embeddings even when generating with
# Claude, since embeddings and generation are decoupled.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Database (optional locally, required for a real deployment) ---
# One Postgres backs both the accounts and the pgvector RAG library. Set this
# when ingesting if you want the material to reach the deployed app; without
# it, ingestion writes only to the local rag_store/ and accounts fall back to
# SQLite. Free options with pgvector: Neon, Supabase.
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Retry policy
MAX_RETRIES=3

# How long one Gemini request may take, and how long one call may take in
# total including retries and backoff. Both matter: the SDK's own retry
# wrapper sleeps and retries inside a single request, so a timeout alone does
# not bound anything. Without the budget a hung call holds its worker thread
# until the process restarts, which the web app sees as a job stuck at
# "running". Keep the budget below FOLIO_JOB_TIMEOUT.
GEMINI_TIMEOUT_S=120
GEMINI_MAX_ELAPSED_S=420

# How many chunks of source material ground each subtopic. Default 6. Chunks
# target 800 characters, so this trades input tokens for calibration against
# real papers. Worth raising for subjects with a deep library.
FOLIO_RAG_TOP_K=6

# Emergency cost and latency brake. Programmatic diagrams and existing safe
# scene specs still render when this is off. Default: 1.
FOLIO_VISUAL_PLANNER_ENABLED=1

# Note on rate limits: without billing enabled, the Gemini free tier caps
# requests per minute on every model, and the pipeline fires several calls in
# parallel per booklet, so it gets rate-limited quickly. Enabling billing is
# the real fix; switching to a cheaper model is not.

# The LONGEST any Class Work section may be, since a tutoring session runs an
# hour. Questions past the cap move into Homework rather than being dropped.
#
# The cap a given booklet is actually built to comes from the student's year
# (booklet_gen/timing.py, `session_plan`): thirty minutes for a Year 1, sixty
# for a Year 9. This setting is the ceiling over all of them, so lowering it
# shortens every booklet and raising it lengthens none beyond its own band.
FOLIO_CLASSWORK_CAP_MINUTES=60
