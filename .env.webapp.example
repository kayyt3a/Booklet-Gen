# Copy to .env and fill in. Do NOT commit the real .env.

# --- Required ---
# Session signing key. Use a long random string in production.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Google Gemini API key used server-side to generate booklets.
GEMINI_API_KEY=your-gemini-key

# --- Model choice (optional) ---
# Two tiers, picked per call in booklet_gen/agents/*.py:
#   FAST   - only used for outline parsing (simple structured extraction).
#            Cheap model is fine here.
#   STRONG - used for everything quality-sensitive: question generation, the
#            LLM judge that validates correctness, the mini-lesson writer,
#            and the Final Challenge generator. This is the one worth
#            spending on, since it is what checks the answer key is right.
# With billing enabled, gemini-2.5-flash is a good default for STRONG.
# Without billing, both default to the free tier and get rate-limited fast
# (the free tier's per-minute request cap is very low regardless of model) -
# see DEPLOY.md for why billing, not just a cheaper model, is the real fix.
GEMINI_MODEL_STRONG=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# --- Database ---
# Set DATABASE_URL to run on Postgres. This backs BOTH the user accounts and
# the pgvector RAG library, so a deployed instance keeps its accounts across
# restarts and has real curriculum grounding. Get one free from Neon or
# Supabase, or use Render Postgres.
#   DATABASE_URL=postgresql://user:password@host/dbname
# Leave it unset for a local checkout: accounts fall back to SQLite (FOLIO_DB)
# and RAG falls back to the on-disk Chroma store in rag_store/.
DATABASE_URL=

# --- Data / behaviour (optional) ---
# Every value below is the default the code already uses. Set one only to
# override it.

# Where the SQLite fallback database lives. Ignored when DATABASE_URL is set.
FOLIO_DB=/data/folio.db
# Where generated PDFs are written before being archived to the database.
FOLIO_OUTPUT=/data/output

# Abuse guards. Both count against a rolling 24h window, and a term plan
# counts as its number of weeks rather than as one booklet.
FOLIO_DAILY_BOOKLET_LIMIT=12
FOLIO_GLOBAL_DAILY_BOOKLET_LIMIT=120

# Seconds before a generation job that never finished is marked failed. A
# booklet is a background thread and a thread cannot be killed from outside,
# so this is what stops a wedged job showing "in progress" forever.
FOLIO_JOB_TIMEOUT=2700

# How many of a user's most recent booklets stay downloadable. Older jobs stay
# listed in My Booklets with the file cleared, shown as "Expired".
FOLIO_FILE_RETENTION=20

# Forces the Secure flag on the session cookie. Left unset it is derived from
# whether DATABASE_URL is set, i.e. on in a real deployment and off on a local
# http checkout where a Secure cookie would never be sent back.
# FOLIO_COOKIE_SECURE=1
