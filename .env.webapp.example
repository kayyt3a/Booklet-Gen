# Copy this file to .env for local development. Never commit the real .env.

# Core application
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
GEMINI_API_KEY=your-gemini-key
DATABASE_URL=
FOLIO_REQUIRE_POSTGRES=0

# Public identity and links
FOLIO_PUBLIC_URL=http://127.0.0.1:5000
FOLIO_BUSINESS_NAME=FolioAI
FOLIO_BUSINESS_COUNTRY=Australia
FOLIO_BUSINESS_NUMBER=
FOLIO_BUSINESS_ADDRESS=
FOLIO_SUPPORT_EMAIL=support@example.com
FOLIO_SUPPORT_PHONE=
FOLIO_ADMIN_EMAILS=owner@example.com

# Stripe one-time purchases
# Leave FOLIO_REQUIRE_PAYMENTS=0 while configuring Stripe test mode.
FOLIO_REQUIRE_PAYMENTS=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_TERM=
FOLIO_PRICE_SINGLE_AUD=7.90
FOLIO_PRICE_TERM_AUD=39.00

# Transactional email over SMTP
# Set FOLIO_REQUIRE_EMAIL_VERIFICATION=1 only after a test email succeeds.
FOLIO_REQUIRE_EMAIL_VERIFICATION=0
FOLIO_EMAIL_FROM=FolioAI <hello@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1

# Private Supabase Storage. The service-role key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FOLIO_STORAGE_BUCKET=booklets

# Generation and worker
# Use inline locally. Production web service uses queue and a separate worker.
FOLIO_JOB_MODE=inline
FOLIO_WORKER_POLL_SECONDS=2
FOLIO_JOB_TIMEOUT=2700
FOLIO_OUTPUT=/data/output
FOLIO_DB=/data/folio.db
FOLIO_FILE_RETENTION=20
FOLIO_DAILY_BOOKLET_LIMIT=12
FOLIO_GLOBAL_DAILY_BOOKLET_LIMIT=120

# Model choices
GEMINI_MODEL_STRONG=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# Session cookie. Leave unset to derive it from the database backend.
# Set to 1 on any HTTPS production deployment.
FOLIO_COOKIE_SECURE=
